HOST=0.0.0.0
PORT=1337

# Security — generate unique values with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS="toBeModified1,toBeModified2,toBeModified3,toBeModified4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (SQLite default; swap to postgres/mysql for production if needed)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Frontend origin (used by CORS + VNPay post-payment redirect)
FRONTEND_URL=http://localhost:5173

# VNPay sandbox (register at https://sandbox.vnpayment.vn)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:1337/api/bookings/vnpay-return
# VNPay refund endpoint (required for the in-app cancel flow)
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# AI chatbot — Google Gemini (https://aistudio.google.com/app/apikey)
GOOGLE_AI_API_KEY=
# ChromaDB vector store
CHROMADB_URL=http://localhost:8000
